# Linux systemd user service template for the `asta-watch` console command.
#
# Keeps the cross-platform watcher running in the background and
# automatically restarts it on login/crash.
#
# Replace every <<PLACEHOLDER>> below with your actual paths, then:
#
#   mkdir -p ~/.config/systemd/user
#   cp sttx-watch.service.template ~/.config/systemd/user/sttx-watch.service
#   # edit the copy to fill in the placeholders
#   systemctl --user daemon-reload
#   systemctl --user enable --now sttx-watch.service
#
# To check status / logs:
#   systemctl --user status sttx-watch.service
#   journalctl --user -u sttx-watch.service -f
#
# To stop it:
#   systemctl --user disable --now sttx-watch.service

[Unit]
Description=Spatial Transcriptomics automatic pipeline watcher
After=default.target

[Service]
Type=simple
WorkingDirectory=<<PATH_TO_DATA_DIR>>
ExecStart=<<PATH_TO_ASTA_WATCH>> --path <<PATH_TO_DATA_DIR>>
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
